{
  "name": "factorio-ai",
  "version": "0.0.1",
  "private": true,
  "description": "AI plays Factorio 2.x + Space Age: sandbox, model harness, training set, desktop UI.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "scripts": {
    "test": "node --env-file-if-exists=.env --test --test-timeout=30000 \"test/*.test.ts\"",
    "test:sandbox": "node --env-file-if-exists=.env --test --test-timeout=3600000 \"test/sandbox/*.test.ts\"",
    "sandbox:demo": "node --env-file-if-exists=.env game/sandbox/cli.ts demo",
    "memory:setup": "node --env-file-if-exists=.env game/memory/setup.ts",
    "offgame:setup": "node --env-file-if-exists=.env game/offgame/setup.ts",
    "client:setup": "node --env-file-if-exists=.env game/client/setup.ts",
    "run:online": "node --env-file-if-exists=.env core/run/online.ts"
  }
}
