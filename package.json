{
  "name": "factorio-ai",
  "version": "0.0.1",
  "private": true,
  "description": "AI plays Factorio 2.x + Space Age: sandbox, model harness, training set, desktop UI.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.319",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "yalps": "^0.6.4"
  },
  "scripts": {
    "test": "node --env-file-if-exists=.env --test --test-timeout=30000 \"test/*.test.ts\"",
    "test:sandbox": "node --env-file-if-exists=.env --test --test-timeout=3600000 \"test/sandbox/*.test.ts\"",
    "test:sandbox-v2": "node --env-file-if-exists=.env --test --test-timeout=3600000 \"test/sandbox-v2/*.test.ts\"",
    "sandbox:demo": "node --env-file-if-exists=.env game/sandbox/cli.ts demo",
    "memory:setup": "node --env-file-if-exists=.env game/memory/setup.ts",
    "offgame:setup": "node --env-file-if-exists=.env game/offgame/setup.ts",
    "client:setup": "node --env-file-if-exists=.env game/client/setup.ts",
    "run:online": "node --env-file-if-exists=.env core/run/online.ts",
    "brains:probe": "node --env-file-if-exists=.env core/brains/probe.ts",
    "play:control": "node --env-file-if-exists=.env src/play/control.ts",
    "play:run": "node --env-file-if-exists=.env src/play/run.ts",
    "play:mk": "node --env-file-if-exists=.env src/play/mk-world.ts",
    "calc": "node --env-file-if-exists=.env src/calc/cli.ts",
    "bp": "node --env-file-if-exists=.env src/blueprint/cli.ts",
    "play:bp": "node --env-file-if-exists=.env src/play/bp.ts",
    "play:shifts": "node --env-file-if-exists=.env src/play/shifts.ts",
    "play:review": "node --env-file-if-exists=.env src/play/review-cli.ts",
    "play:seen": "node --env-file-if-exists=.env src/play/seen.ts",
    "play:tokens": "node --env-file-if-exists=.env src/play/tokens.ts",
    "play:quota": "node --env-file-if-exists=.env src/play/quota-cli.ts",
    "play:check": "node --env-file-if-exists=.env src/play/check.ts",
    "play:world-export": "node --env-file-if-exists=.env src/play/world-export.ts",
    "play:online": "node --env-file-if-exists=.env core/run/online.ts",
    "fp": "node --env-file-if-exists=.env src/play/fp.ts",
    "verify": "node --env-file-if-exists=.env src/lab/cli.ts verify",
    "coverage": "node --env-file-if-exists=.env src/verify/coverage.ts",
    "lab:demo": "node --env-file-if-exists=.env src/lab/cli.ts demo",
    "lab:watch": "node --env-file-if-exists=.env src/lab/cli.ts watch",
    "lab:dump": "node --env-file-if-exists=.env src/lab/cli.ts dump-data",
    "dataset": "node --env-file-if-exists=.env src/dataset/ingest.ts",
    "calc:crosscheck": "node --env-file-if-exists=.env src/calc/fp-crosscheck.ts",
    "search": "node --env-file-if-exists=.env src/search/cli.ts",
    "io:rehearse": "node --env-file-if-exists=.env src/io/rehearse-server.ts",
    "api-catalog": "node --env-file-if-exists=.env tools/api-catalog.mjs"
  }
}
