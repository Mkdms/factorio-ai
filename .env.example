# 复制成 .env 后按本机填写 (.env 不进仓库)
FACTORIO_DIR=C:/Program Files (x86)/Steam/steamapps/common/Factorio
# 沙盘实验要不要另开一个游戏窗口看: 1 = 开, 做完留 SANDBOX_VIEW_LINGER 秒 (默认 60) 再关; 窗口在时速度上限 SANDBOX_VIEW_MAX_SPEED (默认 20)。回归测试不开
SANDBOX_VIEW=0
# 可选: 观看窗口用的独立版目录 (factorio.com 下的完整版, 不走 Steam、不登录, 窗口才能叫别的名字); 没配就用 Steam 版
# FACTORIO_VIEWER_DIR=
# 可选: 本机数据目录 (默认仓库下的 data/)
# DATA_DIR=
# 建议填: 模型的角色目录根 (必须在仓库外: Claude Code 会往上读 CLAUDE.md)。不填时两条路默认不一样 (装模组 ~/factorio-pilot-brain、不装模组 ~/factorio-ai-brain), 界面和备份要找两处
# BRAIN_DIR=
# 可选: 蓝图编辑器 (班末出基地俯视图、./bp render) 的本机目录或网址
# FBE_DIR=
# FBE_URL=
# 可选: 班末自动跑的本机备份命令 (装模组那条路 run.ts 收工时跑; 去向只写在本机)
# PILOT_BACKUP_CMD=
